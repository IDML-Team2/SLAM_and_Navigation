<?xml version="1.0"?>
<package format="3">
  <name>imdl_nav</name>
  <version>1.0.0</version>
  <description>Minimal teaching workspace: build a map with SLAM and drive to coordinates (Create3 + Jetson + RPLidar).</description>
  <maintainer email="todo@todo.com">IMDL</maintainer>
  <license>Apache-2.0</license>

  <!-- Python libraries and message types imported by our own nodes -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>explore_lite_msgs</depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- Third-party nodes started by our launch files -->
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>          <!-- Jetson only -->
  <exec_depend>slam_toolbox</exec_depend>          <!-- Jetson only -->
  <exec_depend>nav2_map_server</exec_depend>       <!-- from here on: laptop only -->
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>irobot_create_description</exec_depend>  <!-- 3D model of the Create3 -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
